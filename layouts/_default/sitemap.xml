{{- $enabledLanguages := where hugo.Sites "Language.Disabled" false -}}
{{- $enabledLanguageCodes := slice -}}
{{- range $enabledLanguages }}
  {{- $enabledLanguageCodes = $enabledLanguageCodes | append .Language.Lang }}
{{- end }}
{{- $pages := .Site.RegularPages -}}
{{- $searchPages := where $pages "Type" "search" -}}
{{- $otherPages := where $pages "Type" "!=" "search" -}}
{{- $otherPages = where $otherPages "Params.hidden" "!=" true -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- /* The home page is not a RegularPage, so it never appears in $otherPages
       and has to be emitted explicitly. Its Lastmod is derived from the newest
       page in the site; on a site with no content pages that is the generated
       search stub and its sentinel date, so only emit lastmod when real content
       pages exist. */ -}}
{{- $home := .Site.Home -}}
  <url>
    <loc>{{ $home.Permalink }}</loc>
    {{- if and $otherPages (not $home.Lastmod.IsZero) }}
    <lastmod>{{ $home.Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    {{- with $home.Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge $home.Sitemap.Priority 0.0 }}
    <priority>{{ $home.Sitemap.Priority }}</priority>
    {{- end }}
    {{- if $home.IsTranslated }}
      {{- range $home.Translations }}
        {{- if in $enabledLanguageCodes .Language.Lang }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Locale | default .Language.Lang }}" href="{{ .Permalink }}" />
        {{- end }}
      {{- end }}
    {{- end }}
  </url>
{{- range $otherPages }}
  {{- if in $enabledLanguageCodes .Language.Lang }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- if .IsTranslated }}
      {{- range .Translations }}
        {{- if in $enabledLanguageCodes .Language.Lang }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Locale | default .Language.Lang }}" href="{{ .Permalink }}" />
        {{- end }}
      {{- end }}
    {{- end }}
  </url>
  {{- end }}
{{- end }}
{{- if $searchPages }}
  {{- $searchPage := index $searchPages 0 -}}
  <url>
    <loc>{{ $searchPage.Permalink }}</loc>
    {{- if not $searchPage.Lastmod.IsZero }}
    <lastmod>{{ $searchPage.Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    {{- with $searchPage.Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge $searchPage.Sitemap.Priority 0.0 }}
    <priority>{{ $searchPage.Sitemap.Priority }}</priority>
    {{- end }}
    {{- $searchTranslations := slice $searchPage -}}
    {{- if $searchPage.IsTranslated }}
      {{- $searchTranslations = $searchTranslations | append $searchPage.Translations -}}
    {{- end }}
    {{- range $searchTranslations }}
      {{- if in $enabledLanguageCodes .Language.Lang }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Locale | default .Language.Lang }}" href="{{ .Permalink }}" />
      {{- end }}
    {{- end }}
  </url>
{{- end }}
</urlset>
